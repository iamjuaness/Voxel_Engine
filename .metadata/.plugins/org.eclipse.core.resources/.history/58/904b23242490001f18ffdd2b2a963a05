package chunks;

import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;

import org.lwjgl.util.vector.Vector3f;

import cube.Block;
import cube.Vertex;
import models.CubeModel;

public class ChunkMesh {

	private List<Vertex> vertices;
	private List<Float> positionList;
	private List<Float> uvsList;
	private List<Float> normalsList;
	
	public float[] positions, uvs, normals;
	
	public Chunck chunck;
	
	public ChunkMesh(Chunck chunck) {
		
		this.chunck = chunck;
		
		vertices = new ArrayList<Vertex>();
		positionList = new ArrayList<Float>();
		uvsList = new ArrayList<Float>();
		normalsList = new ArrayList<Float>();
		
		buildMesh();
		populateLists();
	}
	
	public void update(Chunck chunck) {
		this.chunck = chunck;
		
		buildMesh();
		populateLists();
	}

	private void buildMesh() {
		// Loop through block in chunk and determine which faces are visible
		
		for (int i = 0; i < chunck.getBlocks().size(); i++) {
			Block blockI = chunck.getBlocks().get(i);
			
			boolean px = false, nx = false, py = false, ny = false, pz = false, nz = false;
			
			for (int j = 0; j < chunck.getBlocks().size(); j++) {
				Block blockJ = chunck.getBlocks().get(j);
				
				// PX
				if (((blockI.x + 1) == (blockJ.x)) && ((blockI.y) == (blockJ.y)) && ((blockI.z) == (blockJ.z))) {
					px = true;
				}
				
				// NX
				if (((blockI.x - 1) == (blockJ.x)) && ((blockI.y) == (blockJ.y)) && ((blockI.z) == (blockJ.z))) {
					nx = true;
				}
				
				// PY
				if (((blockI.x) == (blockJ.x)) && ((blockI.y + 1) == (blockJ.y)) && ((blockI.z) == (blockJ.z))) {
					py = true;
				}
				
				// NY
				if (((blockI.x) == (blockJ.x)) && ((blockI.y - 1) == (blockJ.y)) && ((blockI.z) == (blockJ.z))) {
					ny = true;
				}
				
				// PZ
				if (((blockI.x) == (blockJ.x)) && ((blockI.y) == (blockJ.y)) && ((blockI.z + 1) == (blockJ.z))) {
					pz = true;
				}
				
				// NZ
				if (((blockI.x) == (blockJ.x)) && ((blockI.y) == (blockJ.y)) && ((blockI.z - 1) == (blockJ.z))) {
					nz = true;
				}
			}
			
			// Add visible face to the chunck mesh
			
			if (!px) {
				for (int k = 0; k < 6; k++) {
					vertices.add(new Vertex(new Vector3f(CubeModel.PX_POS[k].x + blockI.x, 
							CubeModel.PX_POS[k].y + blockI.y, CubeModel.PX_POS[k].z + blockI.z), 
							CubeModel.UV[k], CubeModel.NORMALS[k]));
				}
			}
			
			if (!nx) {
				for (int k = 0; k < 6; k++) {
					vertices.add(new Vertex(new Vector3f(CubeModel.NX_POS[k].x + blockI.x, 
							CubeModel.NX_POS[k].y + blockI.y, CubeModel.NX_POS[k].z + blockI.z), 
							CubeModel.UV[k], CubeModel.NORMALS[k]));
				}
			}
			
			if (!py) {
				for (int k = 0; k < 6; k++) {
					vertices.add(new Vertex(new Vector3f(CubeModel.PY_POS[k].x + blockI.x, 
							CubeModel.PY_POS[k].y + blockI.y, CubeModel.PY_POS[k].z + blockI.z), 
							CubeModel.UV[k], CubeModel.NORMALS[k]));
				}
			}
			
			if (!ny) {
				for (int k = 0; k < 6; k++) {
					vertices.add(new Vertex(new Vector3f(CubeModel.PX_POS[k].x + blockI.x, 
							CubeModel.PX_POS[k].y + blockI.y, CubeModel.PX_POS[k].z + blockI.z), 
							CubeModel.UV[k], CubeModel.NORMALS[k]));
				}
			}
			
			if (!pz) {
				for (int k = 0; k < 6; k++) {
					vertices.add(new Vertex(new Vector3f(CubeModel.PX_POS[k].x + blockI.x, 
							CubeModel.PX_POS[k].y + blockI.y, CubeModel.PX_POS[k].z + blockI.z), 
							CubeModel.UV[k], CubeModel.NORMALS[k]));
				}
			}
			
			if (!nz) {
				for (int k = 0; k < 6; k++) {
					vertices.add(new Vertex(new Vector3f(CubeModel.PX_POS[k].x + blockI.x, 
							CubeModel.PX_POS[k].y + blockI.y, CubeModel.PX_POS[k].z + blockI.z), 
							CubeModel.UV[k], CubeModel.NORMALS[k]));
				}
			}
		}
	}
	
	private void populateLists() {
		
	}
	
	
}
