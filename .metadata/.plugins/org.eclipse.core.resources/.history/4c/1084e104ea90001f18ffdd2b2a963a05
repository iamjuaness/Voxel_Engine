package toolbox;

import java.nio.FloatBuffer;

import org.lwjgl.BufferUtils;
import org.lwjgl.Sys;
import org.lwjgl.opengl.Display;
import org.lwjgl.util.vector.Vector3f;
import org.lwjgl.opengl.GL11;

import entities.Camera;

public class DebugInfo {
    private static long lastFrameTime;
    private static float fps;
    private static Runtime runtime;
    
    static {
        lastFrameTime = getCurrentTime();
        runtime = Runtime.getRuntime();
    }
    
    private static long getCurrentTime() {
        return Sys.getTime() * 1000 / Sys.getTimerResolution();
    }
    
    public static void updateFPS() {
        long currentFrameTime = getCurrentTime();
        fps = 1000.0f / (currentFrameTime - lastFrameTime);
        lastFrameTime = currentFrameTime;
    }
    
    public static void renderDebugInfo(Camera camera, boolean show) {
        if (!show) return;
        
        // Save the current matrix mode and other states
        GL11.glPushAttrib(GL11.GL_ALL_ATTRIB_BITS);
        GL11.glMatrixMode(GL11.GL_PROJECTION);
        GL11.glPushMatrix();
        GL11.glLoadIdentity();
        GL11.glOrtho(0, Display.getWidth(), Display.getHeight(), 0, -1, 1);
        GL11.glMatrixMode(GL11.GL_MODELVIEW);
        GL11.glPushMatrix();
        GL11.glLoadIdentity();
        
        // Disable depth testing temporarily
        GL11.glDisable(GL11.GL_DEPTH_TEST);
        
        // Get camera position
        Vector3f position = camera.getPosition();
        
        // Calculate memory usage
        long totalMemory = runtime.totalMemory() / 1024 / 1024;
        long usedMemory = (runtime.totalMemory() - runtime.freeMemory()) / 1024 / 1024;
        
        // Prepare debug information strings
        String[] debugInfo = {
            String.format("FPS: %.1f", fps),
            String.format("XYZ: %.2f / %.2f / %.2f", position.x, position.y, position.z),
            String.format("Memory: %dMB / %dMB", usedMemory, totalMemory),
            String.format("Display: %dx%d", Display.getWidth(), Display.getHeight()),
            String.format("Java: %s", System.getProperty("java.version"))
        };
        
        // Render debug information
        GL11.glColor3f(1.0f, 1.0f, 1.0f);  // Set text color to white
        
        int y = 10;
        for (String info : debugInfo) {
            renderString(10, y, info);
            y += 20;
        }
        
        // Restore the previous matrix mode and states
        GL11.glMatrixMode(GL11.GL_PROJECTION);
        GL11.glPopMatrix();
        GL11.glMatrixMode(GL11.GL_MODELVIEW);
        GL11.glPopMatrix();
        GL11.glPopAttrib();
    }
    
    private static void renderString(int x, int y, String text) {
        // Save current color
        FloatBuffer currentColor = BufferUtils.createFloatBuffer(16);
        GL11.glGetFloat(GL11.GL_CURRENT_COLOR, currentColor);
        
        // Enable blending for anti-aliasing
        GL11.glEnable(GL11.GL_BLEND);
        GL11.glBlendFunc(GL11.GL_SRC_ALPHA, GL11.GL_ONE_MINUS_SRC_ALPHA);
        
        // Render the text
        GL11.glRasterPos2i(x, y);
        for (char c : text.toCharArray()) {
            glutBitmapCharacter(GLUT_BITMAP_8_BY_13, c);
        }
        
        // Restore previous color
        currentColor.flip();
        GL11.glColor4f(currentColor.get(0), currentColor.get(1), currentColor.get(2), currentColor.get(3));
    }
    
    // GLUT-like bitmap character rendering
    private static void glutBitmapCharacter(int font, char character) {
        // Simplified character rendering
        // In a real implementation, you would want to use actual texture-based font rendering
        GL11.glBegin(GL11.GL_LINES);
        // Render basic line-based characters
        switch (character) {
            case '0': case '1': case '2': case '3': case '4':
            case '5': case '6': case '7': case '8': case '9':
            case '.': case '/': case ':': case ' ':
                renderDigit(character);
                break;
            default:
                renderLetter(character);
        }
        GL11.glEnd();
    }
    
    private static void renderDigit(char digit) {
        // Simplified digit rendering using lines
        float x = 0;
        float y = 0;
        float size = 8.0f;
        
        switch(digit) {
            case '0':
                GL11.glVertex2f(x, y);
                GL11.glVertex2f(x + size, y);
                GL11.glVertex2f(x + size, y);
                GL11.glVertex2f(x + size, y + size);
                GL11.glVertex2f(x + size, y + size);
                GL11.glVertex2f(x, y + size);
                GL11.glVertex2f(x, y + size);
                GL11.glVertex2f(x, y);
                break;
            case '1':
                GL11.glVertex2f(x + size/2, y);
                GL11.glVertex2f(x + size/2, y + size);
                break;
            // Add cases for other digits as needed
            case '.':
                GL11.glVertex2f(x + size/2, y);
                GL11.glVertex2f(x + size/2, y + 2);
                break;
            case '/':
                GL11.glVertex2f(x, y);
                GL11.glVertex2f(x + size, y + size);
                break;
            case ':':
                GL11.glVertex2f(x + size/2, y + size/4);
                GL11.glVertex2f(x + size/2, y + size/4 + 2);
                GL11.glVertex2f(x + size/2, y + 3*size/4);
                GL11.glVertex2f(x + size/2, y + 3*size/4 + 2);
                break;
        }
    }
    
    private static void renderLetter(char letter) {
        // Simplified letter rendering using lines
        float x = 0;
        float y = 0;
        float size = 8.0f;
        
        switch(Character.toUpperCase(letter)) {
            case 'F':
                GL11.glVertex2f(x, y);
                GL11.glVertex2f(x, y + size);
                GL11.glVertex2f(x, y + size);
                GL11.glVertex2f(x + size, y + size);
                GL11.glVertex2f(x, y + size/2);
                GL11.glVertex2f(x + size*0.8f, y + size/2);
                break;
            case 'P':
                GL11.glVertex2f(x, y);
                GL11.glVertex2f(x, y + size);
                GL11.glVertex2f(x, y + size);
                GL11.glVertex2f(x + size, y + size);
                GL11.glVertex2f(x + size, y + size);
                GL11.glVertex2f(x + size, y + size/2);
                GL11.glVertex2f(x + size, y + size/2);
                GL11.glVertex2f(x, y + size/2);
                break;
            case 'S':
                GL11.glVertex2f(x + size, y + size);
                GL11.glVertex2f(x, y + size);
                GL11.glVertex2f(x, y + size);
                GL11.glVertex2f(x, y + size/2);
                GL11.glVertex2f(x, y + size/2);
                GL11.glVertex2f(x + size, y + size/2);
                GL11.glVertex2f(x + size, y + size/2);
                GL11.glVertex2f(x + size, y);
                GL11.glVertex2f(x + size, y);
                GL11.glVertex2f(x, y);
                break;
            // Add cases for other letters as needed
            default:
                // Simple vertical line for unknown characters
                GL11.glVertex2f(x + size/2, y);
                GL11.glVertex2f(x + size/2, y + size);
        }
    }
    
    private static final int GLUT_BITMAP_8_BY_13 = 0; // Placeholder for font type
}